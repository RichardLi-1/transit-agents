{
  "name": "transit-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning scripts/dev.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build-docs-data.ts && node --disable-warning=ExperimentalWarning scripts/build-simulator.ts && vite build apps/display",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "slack:demo": "node --disable-warning=ExperimentalWarning scripts/slack-demo.ts",
    "replay": "node --disable-warning=ExperimentalWarning clients/replay.ts",
    "decide": "node --disable-warning=ExperimentalWarning clients/decide.ts",
    "approve-skill": "node --disable-warning=ExperimentalWarning clients/approve-skill.ts",
    "agent": "agents/.venv/bin/python agents/main.py",
    "agent:eval": "agents/.venv/bin/python agents/main.py eval",
    "agent:score": "node --disable-warning=ExperimentalWarning evals/score-run.ts",
    "agent:cases": "node --disable-warning=ExperimentalWarning evals/count.ts",
    "agent:test": "agents/.venv/bin/python -m unittest discover -s agents/tests -t agents",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "deploy": "fly deploy && npm run smoke",
    "serve": "node --disable-warning=ExperimentalWarning services/api/src/main.ts",
    "collect": "node --disable-warning=ExperimentalWarning services/api/src/collect.ts",
    "dev:display": "vite apps/display",
    "test": "node --test --test-force-exit --disable-warning=ExperimentalWarning \"evals/**/*.test.ts\" \"packages/**/*.test.ts\" \"services/**/*.test.ts\" \"scripts/**/*.test.ts\" \"apps/**/*.test.ts\" \"clients/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.7",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9"
  }
}
