{
  "name": "transit-agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "vite build apps/display",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "replay": "node --disable-warning=ExperimentalWarning clients/replay.ts",
    "decide": "node --disable-warning=ExperimentalWarning clients/decide.ts",
    "serve": "node --disable-warning=ExperimentalWarning services/api/src/main.ts",
    "collect": "node --disable-warning=ExperimentalWarning services/api/src/collect.ts",
    "dev:display": "vite apps/display",
    "test": "node --test --test-force-exit --disable-warning=ExperimentalWarning \"evals/**/*.test.ts\" \"packages/**/*.test.ts\" \"services/**/*.test.ts\" \"scripts/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9"
  }
}
